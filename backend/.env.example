# This is an example .env file for the Thrifter backend application. It contains environment variables for the database connection, JWT configuration, Cloudinary API credentials, and application settings. The DATABASE_URL variable is used to connect to a PostgreSQL database, while the JWT_SECRET and JWT_EXP_SECONDS variables are used for authentication and token expiration. The CLOUDINARY_* variables are used for managing image uploads and storage with Cloudinary. The DEBUG and SEED_DEMO variables are used to control the application's debug mode and whether to seed the database with demo data during development or testing. This file should be copied to .env and filled with actual values before running the application.
# Database
DATABASE_URL=postgresql://postgres:postgres@localhost/thrifter

# JWT
JWT_SECRET=generate-a-long-random-string-here
JWT_EXP_SECONDS=3600
# Separate secret for one-off vendor SMS/email verification links (7-day TTL).
# Keep this different from JWT_SECRET: rotating JWT_SECRET to force-logout
# sessions must not invalidate verification links already sent out.
VENDOR_VERIFY_SECRET=generate-a-different-long-random-string-here

# Google Sign-In (same Web OAuth client ID used by the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Maps Geocoding API (reverse-geocodes vendor "use my location" coordinates to an address)
GOOGLE_MAPS_API_KEY=your-geocoding-api-key

# Cloudinary (fallback image store for ISPs that block the R2 domain)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 (current image storage)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=thrifter-images
R2_PUBLIC_BASE_URL=https://images.thrifter-ug.com

# PostHog server-side events (public project key, same one the frontend uses)
POSTHOG_PROJECT_API_KEY=phc_your_project_key
POSTHOG_CAPTURE_HOST=https://eu.i.posthog.com

# Nylon Pay (payments)
NYLONPAY_API_KEY=npk_test_your_key
NYLONPAY_API_SECRET=nps_test_your_secret
# Separate from the API secret — generated per API key under Dashboard > API
# Settings > Webhook Configuration, used only to verify webhook signatures.
NYLONPAY_WEBHOOK_SECRET=your_webhook_secret

# Checkout / commerce
DEFAULT_PAYMENT_PROVIDER=nylon
DELIVERY_FEE_SINGLE_VENDOR_UGX=5000
DELIVERY_FEE_MULTI_VENDOR_UGX=10000
VENDOR_COMMISSION_RATE=0.05
CHECKOUT_RESERVATION_MINUTES=20
FRONTEND_BASE_URL=http://localhost:5173

# Vendor premium tier
VENDOR_FREE_ITEM_LIMIT=10
VENDOR_PREMIUM_PRICE_UGX=50000
VENDOR_PREMIUM_PERIOD_DAYS=30

# SMS (EgoSMS / Pahappa Comms API) — leave blank in dev to log messages instead of sending
EGOSMS_USERNAME=your_egosms_username
EGOSMS_PASSWORD=your_egosms_password
EGOSMS_SENDER=Thrifter
ADMIN_ALERT_PHONES=0700111222,0700333444

# App
DEBUG=False
SEED_DEMO=False
